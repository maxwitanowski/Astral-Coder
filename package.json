{
  "name": "astral",
  "productName": "Astral",
  "version": "0.1.0",
  "description": "One console for every coding agent: Claude Code, Codex, Grok and plain shells, per project, per session.",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,yellow \"vite\" \"wait-on http://localhost:5174 && cross-env ASTRAL_DEV=1 electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "rebuild": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.12.0",
    "node-pty": "^1.1.0",
    "simple-icons": "^16.30.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  }
}
